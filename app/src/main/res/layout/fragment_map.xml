<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.13"
            android:text="@string/explore_nearby"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.05"
            android:text="@string/climbing_gyms"
            android:textColor="@color/ink"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/map_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/map_subtitle"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Gym chips: tap one to jump to it on the map (filled in from code) -->
    <HorizontalScrollView
        android:id="@+id/gym_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/gym_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- Map Area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/map_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/line"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/gym_info_card"
        app:layout_constraintTop_toBottomOf="@id/gym_chips_scroll">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Real OpenStreetMap map (osmdroid) -->
            <org.osmdroid.views.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Map Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:background="@drawable/map_controls_background"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/btn_zoom_in"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Zoom in"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/ink" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <ImageButton
                    android:id="@+id/btn_zoom_out"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Zoom out"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/ink" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line" />

                <ImageButton
                    android:id="@+id/btn_my_location"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="My location"
                    android:src="@drawable/ic_my_location"
                    app:tint="@color/ink" />
            </LinearLayout>

            <!-- Required OpenStreetMap credit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="#CCFFFFFF"
                android:paddingHorizontal="4dp"
                android:text="© OpenStreetMap contributors"
                android:textColor="@color/muted"
                android:textSize="9sp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Gym Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/gym_info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="92dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/line"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.13"
                android:text="@string/selected_gym"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/gym_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.04"
                android:text="The Rock Oasis"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/muted" />

                <TextView
                    android:id="@+id/gym_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="388 Carlaw Ave, Toronto, ON"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Climbing types + day pass price -->
            <TextView
                android:id="@+id/gym_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bouldering · Top rope · Lead  ·  $28 day pass"
                android:textColor="@color/ink"
                android:textSize="11sp" />

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gym_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="2.4 km"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/gym_distance_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="from downtown"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gym_hours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Open"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/gym_hours_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="until 11 PM"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Get Directions Button -->
            <Button
                android:id="@+id/btn_directions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_lime"
                android:drawableStart="@drawable/ic_arrow_forward"
                android:drawablePadding="8dp"
                android:text="@string/get_directions"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"
                app:drawableTint="@color/ink" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
