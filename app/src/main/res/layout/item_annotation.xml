<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <View
        android:id="@+id/annotation_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/marker_dark" />

    <TextView
        android:id="@+id/annotation_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="monospace"
        android:text="00:04"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/annotation_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Crux"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/annotation_delete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete marker"
        android:src="@drawable/ic_close"
        app:tint="@color/muted" />
</LinearLayout>
