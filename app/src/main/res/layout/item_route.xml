<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/route_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Route Swatch with Route Icon inside -->
        <FrameLayout
            android:id="@+id/route_swatch_frame"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/swatch_coral">

            <ImageView
                android:id="@+id/route_swatch_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_route"
                app:tint="@color/coral" />
        </FrameLayout>

        <!-- Route Details Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Route Name -->
            <TextView
                android:id="@+id/route_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Pink Arête"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Gym Location -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/muted" />

                <TextView
                    android:id="@+id/route_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Rock Oasis · Toronto"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tags & Rating Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tag 1 -->
                <TextView
                    android:id="@+id/tag_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/stat_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="Arête"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />

                <!-- Tag 2 -->
                <TextView
                    android:id="@+id/tag_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/stat_badge"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="Balance"
                    android:textColor="@color/ink"
                    android:textSize="10sp" />

                <!-- Stars Rating -->
                <TextView
                    android:id="@+id/route_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★☆ 4.0"
                    android:textColor="#E6A21A"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Grade Badge -->
        <TextView
            android:id="@+id/route_grade"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/grade_badge_coral"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="V5"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Chevron -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
