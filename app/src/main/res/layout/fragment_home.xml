<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="100dp">

        <!-- Top Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.13"
                    android:id="@+id/home_date"
                    android:text="Wednesday, September 18"
                    android:textAllCaps="false"
                    android:textColor="#7A867F"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.04"
                    android:text="@string/hello_greeting"
                    android:textColor="@color/ink"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ready for your next project?"
                    android:textColor="#738078"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Profile Avatar Button -->
            <TextView
                android:id="@+id/btn_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/avatar_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="AC"
                android:textColor="@color/lime"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/lime"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp">

                <!-- Left Content Column -->
                <LinearLayout
                    android:id="@+id/hero_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/hero_visual"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Status Pill -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/status_pill_background"
                        android:drawableStart="@drawable/ic_dot_green"
                        android:drawablePadding="6dp"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Weekly progress"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        android:textSize="10sp" />

                    <!-- Headline -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.04"
                        android:lineSpacingMultiplier="0.95"
                        android:text="@string/hero_title"
                        android:textColor="@color/ink"
                        android:textSize="26sp" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.3"
                        android:id="@+id/hero_subtitle"
                        android:text="Two sends this week. One move closer to your first V7."
                        android:textColor="#3D4B30"
                        android:textSize="12sp" />

                    <!-- Record Beta Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_record_beta"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="18dp"
                        android:paddingHorizontal="16dp"
                        android:text="Record new beta"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/ink"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_camera_white"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <!-- Right Side Hero Visual with V7 Orbit & 4 Floating Holds -->
                <FrameLayout
                    android:id="@+id/hero_visual"
                    android:layout_width="100dp"
                    android:layout_height="140dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Route trajectory line -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="110dp"
                        android:layout_gravity="center"
                        android:background="#2E18201D"
                        android:rotation="18" />

                    <!-- Hold H1 (Top) -->
                    <View
                        android:layout_width="26dp"
                        android:layout_height="15dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/hold_h1" />

                    <!-- Hold H2 (Left of V7) -->
                    <View
                        android:layout_width="16dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/hold_h2" />

                    <!-- Orbit Badge V7 in Center -->
                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:background="@drawable/button_dark"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="V7"
                        android:textColor="@color/lime"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Hold H3 (Bottom) -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/hold_h3" />

                    <!-- Hold H4 (Bottom Left small) -->
                    <View
                        android:layout_width="14dp"
                        android:layout_height="12dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/hold_h4" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Stats Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.13"
                            android:text="@string/your_season"
                            android:textAllCaps="true"
                            android:textColor="#7A867F"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.04"
                            android:text="@string/climbing_stats"
                            android:textColor="@color/ink"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_dot_green"
                        android:drawablePadding="6dp"
                        android:id="@+id/stats_updated"
                        android:text="Updated today"
                        android:textColor="#77827B"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Stats Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Stat 1: Total Sends -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="-0.06"
                            android:id="@+id/stat_sends"
                            android:text="14"
                            android:textColor="@color/ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/stat_badge"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:id="@+id/stat_sends_week"
                            android:text="+3"
                            android:textColor="@color/green"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/total_sends"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Stat 2: Active Projects -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="-0.06"
                            android:id="@+id/stat_projects"
                            android:text="06"
                            android:textColor="@color/ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/stat_badge"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:id="@+id/stat_projects_sub"
                            android:text="2 close"
                            android:textColor="@color/green"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/active_projects"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Vertical Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@color/line" />

                    <!-- Stat 3: Top Grade -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:paddingStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="-0.06"
                            android:id="@+id/stat_top_grade"
                            android:text="V6"
                            android:textColor="@color/ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/stat_badge"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:text="Personal best"
                            android:textColor="@color/green"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/top_grade"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Grade Track Progress Bar (72% progress) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:background="#EEF0EC" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_gravity="start"
                        android:background="@color/lime"
                        app:layout_constraintWidth_percent="0.72" />
                    
                    <!-- 72% fill track via custom width proportion -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:weightSum="100">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="72"
                            android:background="@color/lime" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Grade Track Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="V0"
                        android:textColor="#929A95"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="V3"
                        android:textColor="#929A95"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="V6"
                        android:textColor="#929A95"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="V9"
                        android:textColor="#929A95"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Beta Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.13"
                    android:text="ATTEMPT LOG"
                    android:textAllCaps="true"
                    android:textColor="#7A867F"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.04"
                    android:text="@string/recent_beta"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_view_all_routes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:text="@string/view_all_routes"
                android:textColor="#526158"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent attempts (filled from the database) -->
        <LinearLayout
            android:id="@+id/recent_attempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/recent_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No attempts yet. Record or import your first beta!"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
