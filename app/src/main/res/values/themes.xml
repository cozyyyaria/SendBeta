<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SendBeta" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/lime</item>
        <item name="colorPrimaryDark">@color/lime_dark</item>
        <item name="colorOnPrimary">@color/ink</item>
        
        <!-- Surface and background -->
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- CardView stroke support -->
        <item name="materialCardViewStyle">@style/Widget.SendBeta.CardView</item>
        
        <!-- Chip style -->
        <item name="chipStyle">@style/Widget.SendBeta.Chip</item>
    </style>

    <style name="Theme.SendBeta" parent="Base.Theme.SendBeta" />
    
    <!-- Custom CardView style with stroke support -->
    <style name="Widget.SendBeta.CardView" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <!-- Custom Chip style -->
    <style name="Widget.SendBeta.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipCornerRadius">20dp</item>
    </style>
    
    <!-- Bottom Navigation Active Indicator (lime pill) -->
    <style name="Widget.SendBeta.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/lime</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>
    
    <!-- Bottom Nav Text - Active -->
    <style name="TextAppearance.SendBeta.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    
    <!-- Bottom Nav Text - Inactive -->
    <style name="TextAppearance.SendBeta.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#6B7670</item>
    </style>
</resources>
