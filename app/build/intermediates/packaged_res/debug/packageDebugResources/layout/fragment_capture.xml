<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Header with Back Button -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/button_outlined"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.13"
                android:text="@string/new_attempt"
                android:textAllCaps="true"
                android:textColor="#7A867F"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.05"
                android:text="@string/capture_beta"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/capture_hint"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Camera Preview Area with Frame Corners -->
    <FrameLayout
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/controls"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Main Camera Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/ink"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Camera placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/camera_placeholder" />

                <!-- Camera guide overlay pill -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/camera_overlay_pill"
                    android:drawableStart="@drawable/ic_target"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Keep the climber inside the frame"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:drawableTint="@color/white" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Frame Corners Overlay -->
        <!-- Top Left Corner -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/frame_corner_tl" />

        <!-- Top Right Corner -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/frame_corner_tr" />

        <!-- Bottom Left Corner -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="@drawable/frame_corner_bl" />

        <!-- Bottom Right Corner -->
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/frame_corner_br" />
    </FrameLayout>

    <!-- Controls -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        android:paddingVertical="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Flip Button -->
        <FrameLayout
            android:id="@+id/btn_flip"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/button_outlined">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_flip_camera"
                app:tint="@color/ink" />
        </FrameLayout>

        <!-- Record Button -->
        <FrameLayout
            android:id="@+id/btn_record"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/record_button_outer">

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/record_button_inner" />
        </FrameLayout>

        <!-- Gallery Button -->
        <FrameLayout
            android:id="@+id/btn_gallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/button_outlined">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gallery"
                app:tint="@color/ink" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
